=== accept work-group-memory
layout memory(3, unit(16), pointer(32), little), memory(5, unit(8), pointer(16), little)

module @dev() {
  dialects gpu

  func @k(%v: i32) -> i32 {
  ^e:
    %buf: ptr(3) = gpu.work_group_alloca i32 64 align(4) @0
    %i: i32 = gpu.work_item_id gpu.x @0
    %q: ptr(3) = ptradd %buf, %i @0
    store nonatomic %v, %q @0
    %pp: ptr(5) = gpu.work_group_alloca ptr(3) @0
    store nonatomic %q, %pp @0
    %r: ptr(3) = load nonatomic %pp @0
    %w: i32 = load nonatomic %r @0
    ret %w @0
  }

}

locs {
  @0 = unknown
}
=== invalid work-group-alloca-of-nothing
layout memory(3, unit(8), pointer(32), little)

module @dev() {
  dialects gpu

  func @k() -> ptr(3) {
  ^e:
    %p: ptr(3) = gpu.work_group_alloca i32 0 @0
    ret %p @0
  }

}

locs {
  @0 = unknown
}
