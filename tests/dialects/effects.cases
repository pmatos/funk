=== cond_br may-ub,control
func @f(%a: i8, %b: i8, %c: i1) -> i8 {
^entry:
  cond_br %c, ^yes, ^no @0
^yes:
  ret %a @0
^no:
  ret %b @0
}

locs {
  @0 = unknown
}

