=== br control
func @f(%a: i8) -> i8 {
^entry:
  br ^next @0
^next:
  ret %a @0
}

locs {
  @0 = unknown
}

=== cond_br may-ub,control
func @f(%a: i8, %b: i8, %c: i1) -> i8 {
^entry:
  cond_br %c, ^yes, ^no @0
^yes:
  ret %a @0
^no:
  ret %b @0
}

locs {
  @0 = unknown
}

=== ret control
func @f(%a: i8) -> i8 {
^entry:
  ret %a @0
}

locs {
  @0 = unknown
}

=== call pure
func @f(%a: i8) -> i8 {
^entry:
  %r: i8 = call @g %a @0
  ret %r @0
}

func @g(%x: i8) -> i8 {
^entry:
  ret %x @0
}

locs {
  @0 = unknown
}
