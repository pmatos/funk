=== call pure
func @f(%a: i8) -> i8 {
^entry:
  %r: i8 = call @g %a @0
  ret %r @0
}

func @g(%x: i8) -> i8 {
^entry:
  ret %x @0
}

locs {
  @0 = unknown
}
