Cases for the effect summaries of functions (ADR-2026-11-10-2108), shared by
two tests: `lean/FirTest/SummaryCases.lean` and
`crates/funk-ir/tests/summaries.rs`. Each case starts with a line of three
equals signs and its name. Each line after it that starts with `@` gives
the summary of one function: the symbols of the modules that hold it, from
the outermost, then its own symbol, then its summary, written as
`effects.cases` writes a set, with each set of memories in sorted order.
The module's text follows. Each case gives the summary of every function of
every symbol table of its module.

A summary joins what a caller sees of each op of each function that the
function reaches through calls: every effect of those ops but control. A
call resolves in the symbol table that holds its function, and a call of a
symbol that names no function has every effect but control.

=== pure-leaf
@f pure
func @f(%a: i8, %b: i8) -> i8 {
^entry:
  %r: i8 = add %a, %b @0
  ret %r @0
}

locs {
  @0 = unknown
}

=== branch-is-may-ub-not-control
@f may-ub
func @f(%a: i8, %b: i8, %c: i1) -> i8 {
^entry:
  cond_br %c, ^yes, ^no @0
^yes:
  ret %a @0
^no:
  ret %b @0
}

locs {
  @0 = unknown
}

=== direct-call
@f may-ub
@g may-ub
func @f(%a: i8) -> i8 {
^entry:
  %r: i8 = call @g %a @0
  ret %r @0
}

func @g(%x: i8) -> i8 {
^entry:
  %r: i8 = udiv %x, %x @0
  ret %r @0
}

locs {
  @0 = unknown
}

=== chain-of-three
@f may-ub,may-poison
@g may-ub,may-poison
@h may-ub,may-poison
@k may-poison
func @f(%a: i8) -> i8 {
^entry:
  %r: i8 = call @g %a @0
  ret %r @0
}

func @g(%a: i8) -> i8 {
^entry:
  %r: i8 = call @h %a @0
  ret %r @0
}

func @h(%a: i8) -> i8 {
^entry:
  %q: i8 = sdiv %a, %a @0
  %r: i8 = call @k %q @0
  ret %r @0
}

func @k(%a: i8) -> i8 {
^entry:
  %r: i8 = add nsw %a, %a @0
  ret %r @0
}

locs {
  @0 = unknown
}

=== self-recursion
@f pure
@g pure
func @f(%a: i8) -> i8 {
^entry:
  %b: i8 = call @g %a @0
  %r: i8 = call @f %b @0
  ret %r @0
}

func @g(%a: i8) -> i8 {
^entry:
  %r: i8 = xor %a, %a @0
  ret %r @0
}

locs {
  @0 = unknown
}

=== mutual-recursion
@even may-ub
@odd may-ub
@leaf pure
func @even(%a: i8) -> i8 {
^entry:
  %r: i8 = call @odd %a @0
  ret %r @0
}

func @odd(%a: i8) -> i8 {
^entry:
  %b: i8 = call @even %a @0
  %c: i8 = call @leaf %b @0
  %r: i8 = urem %c, %a @0
  ret %r @0
}

func @leaf(%a: i8) -> i8 {
^entry:
  ret %a @0
}

locs {
  @0 = unknown
}

=== poison-through-a-call
@f may-poison
@g may-poison
func @f(%a: i8) -> i8 {
^entry:
  %r: i8 = call @g %a @0
  ret %r @0
}

func @g(%a: i8) -> i8 {
^entry:
  %r: i8 = shl %a, %a @0
  ret %r @0
}

locs {
  @0 = unknown
}

=== a-callee-not-called-is-left-out
@f pure
@g may-ub
func @f(%a: i8) -> i8 {
^entry:
  ret %a @0
}

func @g(%a: i8) -> i8 {
^entry:
  %r: i8 = sdiv %a, %a @0
  ret %r @0
}

locs {
  @0 = unknown
}

=== nested-table
@f may-ub
@g may-ub
@dev @f pure
@dev @g pure
func @f(%a: i8) -> i8 {
^entry:
  %r: i8 = call @g %a @0
  ret %r @0
}

func @g(%a: i8) -> i8 {
^entry:
  %r: i8 = udiv %a, %a @0
  ret %r @0
}

module @dev() {
  func @f(%a: i8) -> i8 {
  ^entry:
    %r: i8 = call @g %a @0
    ret %r @0
  }

  func @g(%a: i8) -> i8 {
  ^entry:
    %r: i8 = and %a, %a @0
    ret %r @0
  }

}

locs {
  @0 = unknown
}

=== nested-two-levels
@main pure
@host @dev @k may-poison
@host @dev @f may-poison
func @main(%a: i8) -> i8 {
^entry:
  ret %a @0
}

module @host() {
  module @dev() {
    func @k(%a: i8) -> i8 {
    ^entry:
      %r: i8 = poison @0
      ret %r @0
    }

    func @f(%a: i8) -> i8 {
    ^entry:
      %r: i8 = call @k %a @0
      ret %r @0
    }

  }

}

locs {
  @0 = unknown
}

=== unknown-callee
@f reads(*),writes(*),allocates(*),may-ub,may-poison,observable
func @f(%a: i8) -> i8 {
^entry:
  %r: i8 = call @nowhere %a @0
  ret %r @0
}

locs {
  @0 = unknown
}
