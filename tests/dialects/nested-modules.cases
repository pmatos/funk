Cases for the dialect sets of nested modules (ADR-2026-11-10-1510), shared
by the two validators' tests: `lean/FirTest/DialectSet.lean` and
`crates/funk-ir/tests/dialect_set.rs`. They read them as they read
`dialect-set.cases`, in the sum of the core and the test dialect `toy`.
A nested module's dialect set is its own, not its parent's: each symbol
table keeps to its own set, and a nested module that names no dialect uses
the core alone, whatever its parent names.

=== accept nested-names-toy
func @f(%a: i8) -> i8 {
^entry:
  ret %a @0
}

module @dev() {
  dialects toy

  func @f(%a: i8) -> i1 {
  ^entry:
    %f: toy.flag = toy.flag %a @0
    %b: i1 = toy.test %f @0
    ret %b @0
  }

}

locs {
  @0 = unknown
}
=== accept nested-core-in-toy
dialects toy

func @f(%a: i8) -> i1 {
^entry:
  %f: toy.flag = toy.flag %a @0
  %b: i1 = toy.test %f @0
  ret %b @0
}

module @dev() {
  func @f(%a: i8) -> i8 {
  ^entry:
    %s: i8 = add %a, %a @0
    ret %s @0
  }

}

locs {
  @0 = unknown
}
=== accept toy-two-levels-down
module @host() {
  module @dev() {
    dialects toy

    func @g(%f: toy.flag) -> i1 {
    ^entry:
      %b: i1 = toy.test %f @0
      ret %b @0
    }

  }

}

locs {
  @0 = unknown
}
=== reject nested-does-not-inherit-the-set
dialects toy

module @dev() {
  func @f(%a: i8) -> i1 {
  ^entry:
    %f: toy.flag = toy.flag %a @0
    %b: i1 = toy.test %f @0
    ret %b @0
  }

}

locs {
  @0 = unknown
}
=== reject nested-type-outside-its-set
module @host() {
  dialects toy

  module @dev() {
    func @g(%f: toy.flag) {
    ^entry:
      ret @0
    }

  }

}

locs {
  @0 = unknown
}
=== reject parent-does-not-get-the-nested-set
func @f() {
^entry:
  toy.note 7 @0
  ret @0
}

module @dev() {
  dialects toy

}

locs {
  @0 = unknown
}
=== reject nested-unknown-dialect
module @dev() {
  dialects gpu

}

locs {
}
=== reject nested-named-twice
module @dev() {
  dialects toy, toy

}

locs {
}
